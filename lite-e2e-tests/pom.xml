<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.vab</groupId>
        <artifactId>va-bags</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>lite-e2e-tests</artifactId>
    <name>VA-BAGS :: Lite E2E Tests</name>

    <!--
      LITE black-box happy-path e2e (REST Assured + Awaitility). Drives the running
      Lite stack: infra via docker-compose.lite.yml + the 4 Lite services + gateway
      (lite profile). No Keycloak/token — auth is off; identity via X-Subscriber-Id.
      The saga is async (Kafka command/reply → CDC outbox relay), so the test POSTs
      then polls GET /v1/orders/{id} until COMPLETED.

      Not run by a normal `mvn test` (class ends in *E2E). Run explicitly:
          mvn -pl lite-e2e-tests -Pe2e test
      Override the gateway base URL with -Dvab.gateway.url=... when not on localhost.
    -->

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!-- Opt-in: actually run the *E2E classes against a live Lite stack. -->
        <profile>
            <id>e2e</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <includes>
                                <include>**/*E2E.java</include>
                            </includes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
