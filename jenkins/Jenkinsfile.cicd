// VA-BAGS Lite — COMBINED CI+CD pipeline (Jenkins declarative).
//
// One pipeline, fail-fast, ECR-only:
//   Checkout
//    -> Build + Unit + IT (mvn -Pit verify)        // JaCoCo unit+IT -> target/site/jacoco/jacoco.xml
//    -> SonarQube analysis (scanner on this agent)
//    -> Quality Gate (waitForQualityGate)           // FAILS THE BUILD before anything ships
//    -> Build 4 images (Dockerfile.lite)
//    -> Push to ECR                                 // EC2 instance-profile role (IMDS), no stored keys
//    -> [manual approval]                           // input gate before spending on AWS
//    -> Deploy to EKS (kustomize)
//    -> Happy-path e2e
//
// This is additive: jenkins/Jenkinsfile.ci (CI + Docker Hub) and jenkins/Jenkinsfile.aws (CD)
// are kept as-is. Use this when you want a single end-to-end run.
//
// SonarQube: an on-demand Community container on THIS host (jenkins/docker-compose.sonar.yml).
//   Bring it up before running:  docker compose -f jenkins/docker-compose.sonar.yml up -d
//   Configure once in Jenkins:    Manage Jenkins > System > SonarQube servers, name 'sonarqube',
//                                 URL http://localhost:9000, token credential (Secret text).
//   Configure once in SonarQube:  Administration > Webhooks > http://host.docker.internal:8080/sonarqube-webhook/
//   (the webhook is what wakes waitForQualityGate). See Design/lite-jenkins-guide.md §9.
//
// Agent needs: JDK17 + Maven (Global Tools), docker + a daemon, aws CLI, kubectl, kustomize, curl.
pipeline {
  agent any
  //agent { label 'linux' }   // pin to the WSL2/EC2 Linux agent (see guide §7)

  options {
    timestamps()
    disableConcurrentBuilds()
    timeout(time: 40, unit: 'MINUTES')   // whole run incl. the manual approval wait
  }

  tools {
    jdk   'jdk17'
    maven 'maven3'
  }

  parameters {
    booleanParam(name: 'RUN_SONAR', defaultValue: true,  description: 'Run SonarQube analysis + quality gate')
    booleanParam(name: 'RUN_E2E',   defaultValue: true,  description: 'Run happy-path e2e after the EKS deploy')
    string(name: 'AWS_REGION',       defaultValue: 'ap-south-1', description: 'AWS region')
    string(name: 'EKS_CLUSTER_NAME', defaultValue: 'vabags-lite', description: 'EKS cluster name')
  }

  environment {
    LITE_MODULES      = 'api-gateway lite-order-service lite-inventory-service lite-billing-service'
    LITE_MODULES_CSV  = 'api-gateway,lite-order-service,lite-inventory-service,lite-billing-service'
    K8S_NAMESPACE     = 'vabags-lite'
    SONAR_PROJECT_KEY = 'vabags-lite'
  }

  stages {
    stage('Checkout') {
      steps { checkout scm }
      // For manual runs not triggered from SCM, swap to:
      // steps { git branch: 'cicdLite', url: 'https://github.com/PDipak27/Value_added_benefits_GoodsServices_Base.git' }
    }

    // Testcontainers spins real Postgres + Kafka; the `it` profile pins IST on the failsafe JVM.
    // Surefire (unit) + failsafe (IT) both feed one JaCoCo exec -> jacoco.xml at `verify`.
    stage('Build + Unit + IT') {
      steps {
        sh '''
          mvn -B -ntp -Dlite -Pit \
            -pl "$LITE_MODULES_CSV" -am \
            verify
        '''
      }
      post {
        always {
          junit testResults: '**/target/surefire-reports/*.xml, **/target/failsafe-reports/*.xml',
                allowEmptyResults: true
          // Combined unit+IT coverage for humans; Sonar consumes the same jacoco.xml below.
          archiveArtifacts artifacts: '**/target/site/jacoco/jacoco.xml', allowEmptyArchive: true, fingerprint: false
        }
      }
    }

    // withSonarQubeEnv injects SONAR_HOST_URL + SONAR_AUTH_TOKEN from the 'sonarqube' server config.
    // We pass them explicitly to OVERRIDE the values hardcoded in pom.xml (host/token) so the
    // pipeline uses Jenkins-managed creds, not the committed token. Sonar auto-detects the JaCoCo xml.
    stage('SonarQube analysis') {
      when { expression { return params.RUN_SONAR } }
      steps {
        withSonarQubeEnv('sonarqube') {
          sh '''
            echo "Waiting for SonarQube at $SONAR_HOST_URL ..."
            for i in $(seq 1 30); do
              if curl -sf "$SONAR_HOST_URL/api/system/status" | grep -q '"status":"UP"'; then
                echo "SonarQube is UP"; break
              fi
              [ "$i" = "30" ] && { echo "SonarQube not UP - is the compose stack running?"; exit 1; }
              sleep 5
            done
            mvn -B -ntp -Dlite \
              -pl "$LITE_MODULES_CSV" -am \
              sonar:sonar \
              -Dsonar.host.url="$SONAR_HOST_URL" \
              -Dsonar.token="$SONAR_AUTH_TOKEN" \
              -Dsonar.projectKey="$SONAR_PROJECT_KEY"
          '''
        }
      }
    }

    // sonar:sonar returns immediately (analysis is async on the server). waitForQualityGate blocks
    // until SonarQube POSTs the webhook back to Jenkins, then aborts the build if the gate != OK.
    stage('Quality Gate') {
      when { expression { return params.RUN_SONAR } }
      steps {
        timeout(time: 10, unit: 'MINUTES') {
          waitForQualityGate abortPipeline: true
        }
      }
    }

    stage('Build + push images to ECR') {
      steps {
        // Auth from the EC2 instance-profile role (IMDS) — no withCredentials needed.
        sh '''
          ACCOUNT_ID=$(aws sts get-caller-identity --query Account --output text)
          REGISTRY="$ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com"
          aws ecr get-login-password --region "$AWS_REGION" | docker login --username AWS --password-stdin "$REGISTRY"
          SHA=$(git rev-parse --short HEAD)
          for s in $LITE_MODULES; do
            aws ecr describe-repositories --repository-names "vabags/$s" --region "$AWS_REGION" >/dev/null 2>&1 \
              || aws ecr create-repository --repository-name "vabags/$s" --region "$AWS_REGION" >/dev/null
            docker build -f Dockerfile.lite --build-arg MODULE="$s" \
              -t "$REGISTRY/vabags/$s:$SHA" -t "$REGISTRY/vabags/$s:latest" .
            docker push "$REGISTRY/vabags/$s:$SHA"
            docker push "$REGISTRY/vabags/$s:latest"
          done
        '''
      }
    }

    // Manual gate: nothing touches AWS/EKS until a human approves. Aborting here ends the run
    // cleanly (images are already in ECR; deploy simply doesn't happen).
    stage('Approve EKS deploy') {
      steps {
        timeout(time: 30, unit: 'MINUTES') {
          input message: 'Deploy the freshly-pushed images to EKS?', ok: 'Deploy'
        }
      }
    }

    stage('Deploy to EKS') {
      steps {
        sh '''
          ACCOUNT_ID=$(aws sts get-caller-identity --query Account --output text)
          REGISTRY="$ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com"
          aws eks update-kubeconfig --name "$EKS_CLUSTER_NAME" --region "$AWS_REGION"
          SHA=$(git rev-parse --short HEAD)
          ( cd k8s-lite-aws
            for s in $LITE_MODULES; do kustomize edit set image "vabags/$s=$REGISTRY/vabags/$s:$SHA"; done )
          kubectl kustomize --load-restrictor=LoadRestrictionsNone k8s-lite-aws | kubectl apply -f -
          kubectl -n "$K8S_NAMESPACE" rollout status deploy/postgres deploy/kafka deploy/zookeeper deploy/eventuate-cdc --timeout=360s
          kubectl -n "$K8S_NAMESPACE" rollout status deploy/lite-inventory-service deploy/lite-billing-service --timeout=360s
          kubectl -n "$K8S_NAMESPACE" rollout status deploy/lite-order-service --timeout=360s
          kubectl -n "$K8S_NAMESPACE" rollout status deploy/api-gateway --timeout=360s
        '''
      }
    }

    stage('Happy-path e2e') {
      when { expression { return params.RUN_E2E } }
      steps {
        sh '''
          aws eks update-kubeconfig --name "$EKS_CLUSTER_NAME" --region "$AWS_REGION"
          kubectl -n "$K8S_NAMESPACE" port-forward svc/api-gateway 8089:8089 >pf-gw.log 2>&1 &
          kubectl -n "$K8S_NAMESPACE" port-forward svc/lite-order-service 8081:8081 >pf-order.log 2>&1 &
          sleep 8
          mvn -B -ntp -Dlite -pl lite-e2e-tests -Pe2e test \
            -Dvab.gateway.url=http://localhost:8089 \
            -Dvab.order.url=http://localhost:8081
        '''
      }
    }
  }

  post {
    always {
      sh 'pkill -f "kubectl.*port-forward" || true; docker logout || true'
      cleanWs()
    }
  }
}
