<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.vab</groupId>
        <artifactId>va-bags</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>payment-sim</artifactId>
    <name>VA-BAGS :: Payment Provider Simulator</name>

    <!-- Stands in for an external payment provider (Design/15): API-key auth for the merchant (billing),
         a hosted checkout page for the subscriber, and HMAC-signed webhooks back to billing. Deliberately
         NOT a saga participant and knows nothing about orders: no Tram, no shared-events, no DB. -->
    <dependencies>
        <dependency>
            <groupId>com.vab</groupId>
            <artifactId>shared-observability</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.vab.paymentsim.PaymentSimApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
