# Copy to `.secrets` (gitignored) and fill in. Passed to act with --secret-file .secrets
# SonarQube: Administration → Security → generate a user/project token.
SONAR_TOKEN=your-sonarqube-token
# Docker Hub: your username + a Personal Access Token (Account Settings → Security).
DOCKERHUB_USERNAME=your-dockerhub-username
DOCKERHUB_TOKEN=your-dockerhub-access-token
